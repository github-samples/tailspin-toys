// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "Intero (Astro + Node)",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:5-26-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"GitHub.copilot",
				"GitHub.copilot-chat",
				"astro-build.astro-vscode",
				"dbaeumer.vscode-eslint"
			]
		}
	},
	// Install Node dependencies and Playwright's Chromium browser.
	"postCreateCommand": "npm ci && npx playwright install --with-deps chromium",
	// Intero Node runtime.
	"forwardPorts": [4321]
}
