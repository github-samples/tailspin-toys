---
import { formatRatingLabel, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
}

const { rating } = Astro.props;
---

<div class="flex items-center">
    <span class="bg-blue-500/20 text-blue-400 text-sm px-3 py-1 rounded-full" data-testid="game-rating">
        {rating !== null && <span class="text-yellow-400" aria-hidden="true">{formatStarRating(rating)}</span>}
        {formatRatingLabel(rating)}
    </span>
</div>
