---
import { formatRatingOutOfFive, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
}

const { rating } = Astro.props;
---

<div class="flex items-center">
    <span class="bg-blue-500/20 text-blue-400 text-sm px-3 py-1 rounded-full" data-testid="game-rating">
        {rating === null ? (
            formatRatingOutOfFive(rating)
        ) : (
            <>
                <span class="text-yellow-400 mr-1" aria-hidden="true">{formatStarRating(rating)}</span>
                {formatRatingOutOfFive(rating)}
            </>
        )}
    </span>
</div>
