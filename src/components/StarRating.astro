---
import { formatRatingSummary, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
}

const { rating } = Astro.props;
---

<div class="flex items-center" data-testid="game-rating">
    {rating === null ? (
        <span class="text-slate-400 text-sm">{formatRatingSummary(rating)}</span>
    ) : (
        <span class="bg-blue-500/20 text-blue-400 text-sm px-3 py-1 rounded-full">
            <span class="text-yellow-400" aria-hidden="true">{formatStarRating(rating)}</span>
            {formatRatingSummary(rating)}
        </span>
    )}
</div>
