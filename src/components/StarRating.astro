---
import { formatRatingScore, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
    showEmpty?: boolean;
}

const { rating, showEmpty = false } = Astro.props;
---

{rating !== null ? (
    <div class="flex items-center">
        <span class="bg-blue-500/20 text-blue-400 text-sm px-3 py-1 rounded-full" data-testid="game-rating">
            <span class="text-yellow-400" aria-hidden="true">{formatStarRating(rating)}</span>
            {formatRatingScore(rating)}
        </span>
    </div>
) : showEmpty && (
    <div class="flex items-center">
        <span class="bg-slate-700/50 text-slate-400 text-sm px-3 py-1 rounded-full" data-testid="game-rating">
            {formatRatingScore(rating)}
        </span>
    </div>
)}
