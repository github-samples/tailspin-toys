---
/**
 * Renders the statically generated game catalog and its accessible filters.
 */
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form method="get" class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
        <div class="grid gap-6 md:grid-cols-2">
          <fieldset>
            <legend class="mb-3 text-sm font-semibold text-slate-200">Categories</legend>
            <div class="grid gap-2 sm:grid-cols-2">
              {categories.map((category) => (
                <label class="flex items-center gap-2 text-sm text-slate-300">
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-700 text-blue-500 focus:ring-2 focus:ring-blue-500"
                    data-testid={`category-filter-${category.id}`}
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div>
            <label for="publisher-filter" class="mb-3 block text-sm font-semibold text-slate-200">Publisher</label>
            <select
              id="publisher-filter"
              name="publisher"
              class="w-full rounded-lg border border-slate-600 bg-slate-700 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </div>
        </div>

        <button
          type="submit"
          class="mt-6 rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-400 focus:outline-none"
          data-testid="apply-filters"
        >
          Apply filters
        </button>
        <a
          href="/"
          class="ml-3 text-sm text-slate-300 underline hover:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="clear-filters"
        >
          Clear filters
        </a>
      </form>

      <div data-testid="no-filter-results" hidden>
        <EmptyState text="No games match the selected filters." />
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const selectedCategories = new Set(params.getAll('category'));
  const selectedPublisher = params.get('publisher') ?? '';
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');

  document.querySelectorAll<HTMLInputElement>('input[name="category"]').forEach((input) => {
    input.checked = selectedCategories.has(input.value);
  });

  const publisherFilter = document.querySelector<HTMLSelectElement>('#publisher-filter');
  if (publisherFilter) {
    publisherFilter.value = selectedPublisher;
  }

  const hasFilters = selectedCategories.size > 0 || selectedPublisher !== '';
  const visibleCards = cards.filter((card) => {
    const categoryMatches =
      selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
    const publisherMatches =
      selectedPublisher === '' || selectedPublisher === (card.dataset.publisherId ?? '');
    const matches = categoryMatches && publisherMatches;
    card.hidden = !matches;
    return matches;
  });

  if (hasFilters && visibleCards.length === 0 && noResults) {
    noResults.hidden = false;
    if (grid) {
      grid.hidden = true;
    }
  }
</script>
