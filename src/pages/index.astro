---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import GameFilters from '../components/GameFilters.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getFilteredGames } from '../lib/games';
import type { Category, Publisher } from '../types/game';

export const prerender = true;

const games = await getFilteredGames(getDatabase());
const categories = Array.from(
    new Map(
        games
            .filter((game) => game.category !== null)
            .map((game) => [game.category!.id, game.category!]),
    ).values(),
).sort((first: Category, second: Category) => first.name.localeCompare(second.name));
const publishers = Array.from(
    new Map(
        games
            .filter((game) => game.publisher !== null)
            .map((game) => [game.publisher!.id, game.publisher!]),
    ).values(),
).sort((first: Publisher, second: Publisher) => first.name.localeCompare(second.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <GameFilters {categories} {publishers} totalGames={games.length} />
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div data-testid="filter-empty-state" hidden>
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>
